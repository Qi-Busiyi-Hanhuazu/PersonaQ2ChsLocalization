[
  {
    "key": "MSG_000_0",
    "original": "あの男って、まさか…ひかりの…",
    "translation": "あの男って、まさか…ひかりの…",
    "stage": 1,
    "context": "佐倉 双葉"
  },
  {
    "key": "MSG_001_0",
    "original": "ああ。捨てきれなかった気持ちが\n作り出した存在、って言ってたね。",
    "translation": "ああ。捨てきれなかった気持ちが\n作り出した存在、って言ってたね。",
    "stage": 1,
    "context": "Ｐ３主人公"
  },
  {
    "key": "MSG_002_0",
    "original": "今の映像の冒頭部分ですが、先ほど僕たちが\n見たものと一言一句同じでしたね。",
    "translation": "今の映像の冒頭部分ですが、先ほど僕たちが\n見たものと一言一句同じでしたね。",
    "stage": 1,
    "context": "白鐘 直斗"
  },
  {
    "key": "MSG_002_1",
    "original": "でもさっきのとは、ひかりさんへの気持ちが\n全く違うものに感じられました。",
    "translation": "でもさっきのとは、ひかりさんへの気持ちが\n全く違うものに感じられました。",
    "stage": 1,
    "context": "白鐘 直斗"
  },
  {
    "key": "MSG_003_0",
    "original": "ね、ねえ！\nそれより、ひかりちゃんは！？",
    "translation": "ね、ねえ！\nそれより、ひかりちゃんは！？",
