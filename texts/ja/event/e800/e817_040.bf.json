  },
  {
    "key": "SEL_006_1",
    "original": "怪盗みたいだ",
    "translation": "怪盗みたいだ",
    "stage": 1,
    "context": ""
  },
  {
    "key": "MSG_007_0",
    "original": "相手の足取りが掴めないのはイタいな…",
    "translation": "相手の足取りが掴めないのはイタいな…",
    "stage": 1,
    "context": "モルガナ"
  },
  {
    "key": "MSG_008_0",
    "original": "まさか！？",
    "translation": "まさか！？",
    "stage": 1,
    "context": "真田 明彦"
  },
  {
    "key": "MSG_009_0",
    "original": "違えよ！\nジョーカーも紛らわしいこと言うな！",
    "translation": "違えよ！\nジョーカーも紛らわしいこと言うな！",
    "stage": 1,
    "context": "モルガナ"
  },
  {
    "key": "MSG_010_0",
    "original": "でも、街の人たちの様子、\nずいぶんと変わったよね。",
    "translation": "でも、街の人たちの様子、\nずいぶんと変わったよね。",
    "stage": 1,
    "context": "高巻 杏"
  },
  {
    "key": "MSG_011_0",
    "original": "だな。もっとテキトーにあしらわれっか\nと思ったんだけどな。",
    "translation": "だな。もっとテキトーにあしらわれっか\nと思ったんだけどな。",
    "stage": 1,
    "context": "坂本 竜司"
  },
  {
    "key": "MSG_012_0",
    "original": "ん？　どういうことだ。",
    "translation": "ん？　どういうことだ。",
    "stage": 1,
    "context": "桐条 美鶴"
  },
  {
    "key": "MSG_013_0",
    "original": "この街って元々エラそうな支配者がいて\nみんなソイツの言いなりだったんすよ。",
    "translation": "この街って元々エラそうな支配者がいて\nみんなソイツの言いなりだったんすよ。",
    "stage": 1,
    "context": "坂本 竜司"
  },
  {
    "key": "MSG_013_1_0",
    "original": "みんなソイツに頼りきりで、\n誰も自分で動こうとしなくて…",
    "translation": "みんなソイツに頼りきりで、\n誰も自分で動こうとしなくて…",
    "stage": 1,
    "context": "坂本 竜司"
  },
  {
    "key": "MSG_014_0",
    "original": "でも今は、みんなそれぞれで何とかしよう\nとしてるみたい。",
    "translation": "でも今は、みんなそれぞれで何とかしよう\nとしてるみたい。",
    "stage": 1,
    "context": "高巻 杏"
  },
  {
    "key": "MSG_014_1_0",
    "original": "私たちにも事件解決に繋がるならって、\n積極的に話してくれたし。",
    "translation": "私たちにも事件解決に繋がるならって、\n積極的に話してくれたし。",
    "stage": 1,
    "context": "高巻 杏"
  },
  {
    "key": "MSG_015_0",
    "original": "ほう、そんなことが…",
    "translation": "ほう、そんなことが…",
    "stage": 1,
    "context": "桐条 美鶴"
  },
  {
    "key": "MSG_016_0",
    "original": "上に立つ者次第で、下にいる人々も変わる…\n見せつけられた気がするな。",
